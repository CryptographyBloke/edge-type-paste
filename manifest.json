{
  "manifest_version": 3,
  "name": "逐字输入",
  "version": "0.3.7",
  "description": "在侧边栏输入文字，再逐字输入到网页编辑框。",
  "permissions": ["storage", "tabs", "debugger", "sidePanel", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开逐字输入侧边栏"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
